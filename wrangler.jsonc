// 星图 status-galaxy —— Cloudflare Worker 配置
// 采集器（cron 每 15 分钟）+ /api/galaxy + three.js 前端静态托管，全部同源。
{
  "name": "status-galaxy",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./webapp/dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "status-galaxy",
      "database_id": "1860d9a2-43d9-4f08-b990-74e25cb410c5"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "routes": [
    { "pattern": "status.adcakeyuan.top", "custom_domain": true }
  ]
  // ADMIN_TOKEN（手动触发 /api/collect 用）走 wrangler secret put ADMIN_TOKEN；本地开发在 .dev.vars
}
